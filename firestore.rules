rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin check — reads from a config document you create once in Firebase Console:
    // Collection: config / Document ID: admins / Field: emails (array of admin email strings)
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/config/admins) &&
        request.auth.token.email in
          get(/databases/$(database)/documents/config/admins).data.emails;
    }

    // Visitors collection
    match /visitors/{visitorId} {
      // Any logged-in user can read (guards see recent list, admins see dashboard)
      allow read: if request.auth != null;

      // Guards can create new check-ins — enforce required fields and safe defaults
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
            'name', 'phone', 'photoUrl', 'purpose',
            'checkInTime', 'status', 'flagged',
            'checkedInBy', 'checkedInByName'
           ])
        && request.resource.data.status == 'checked-in'
        && request.resource.data.flagged == false
        && request.resource.data.checkedInBy == request.auth.uid;

      // Guards can only update status+checkOutTime (checkout).
      // Admins can update any field (flag, notes, photo).
      allow update: if request.auth != null && (
        isAdmin() ||
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['status', 'checkOutTime'])
      );

      // Only admins can delete visitor records
      allow delete: if isAdmin();
    }

    // Blocklist collection
    match /blocklist/{entryId} {
      // All authenticated users can read (needed for real-time gate alert)
      allow read: if request.auth != null;

      // Only admins can add, edit, or remove blocklist entries
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['name', 'reason', 'addedBy', 'addedAt'])
        && request.resource.data.addedBy == request.auth.token.email;
      allow update, delete: if isAdmin();
    }

    // Config collection — readable by all auth users, never writable from client
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
