rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any authenticated user can read and write visitors
    // (both security guards checking in and admins viewing logs)
    match /visitors/{visitorId} {
      allow read, write: if request.auth != null;
    }

    // Any authenticated user can read the blocklist (for real-time warning at gate)
    // Only write from authenticated users (admin-only enforcement is handled in the app)
    match /blocklist/{entryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
