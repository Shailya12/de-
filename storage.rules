rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /visitors/{visitorId}/{fileName} {
      // Any authenticated user can read photos (needed for admin dashboard thumbnails)
      allow read: if request.auth != null;

      // Only allow JPEG uploads, max 5MB, by authenticated users
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Only allow delete by the user who created the record
      // (enforced at app level; this is a belt-and-suspenders check)
      allow delete: if request.auth != null;
    }
  }
}
